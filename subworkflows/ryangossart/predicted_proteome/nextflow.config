/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default ext.* config for the predicted_proteome subworkflow's modules
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Generic, species-agnostic defaults so CPAT_CPAT/CPAT_FILTER/SQANTI_PROTEINCLASSIFICATION
    work standalone (no bare params.* reads in their main.nf). An installing pipeline's own
    conf/modules.config can override these with its own real, user-facing params -- this
    file's includeConfig MUST come before any such override config for that to win.
----------------------------------------------------------------------------------------
*/
process {
    withName: 'CPAT_CPAT' {
        ext.min_orf = 75
        ext.top_orf = 5
    }
    withName: 'CPAT_FILTER' {
        ext.cpat_coding_threshold = 0.364
    }
    withName: 'SQANTI_PROTEINCLASSIFICATION' {
        ext.min_junctions_after_stop = 0
        ext.protein_class_keep = 'FPM,NPC,NPE'
    }
}
