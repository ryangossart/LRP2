/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default ext.* config for the transcriptome subworkflow's modules
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Generic defaults so GTF_LRP2FILTERTRANSCRIPTOME works standalone (no bare
    params.* reads in its main.nf). An installing pipeline's own
    conf/modules.config can override these with its own params.*-sourced
    values -- this file's includeConfig MUST come before any such override
    config for that to win.
----------------------------------------------------------------------------------------
*/
process {
    withName: 'GTF_LRP2FILTERTRANSCRIPTOME' {
        ext.protein_coding_filter = false
        ext.internal_priming_filter = false
        ext.template_switching_filter = false
        ext.percent_polya_threshold = 100
        ext.transcript_class_keep = 'ALL'
    }
}
