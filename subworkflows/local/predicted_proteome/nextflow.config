/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default ext.* config for the predicted_proteome subworkflow's modules
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Generic, species-agnostic defaults so CPAT_ORF/FILTER_CPAT/PROTEIN_CLASSIFICATION
    work standalone (no bare params.* reads in their main.nf). LRP2's own
    conf/modules.config intentionally overrides these with its real, user-facing,
    species-aware params -- this file's includeConfig in nextflow.config MUST come
    before includeConfig 'conf/modules.config' for that override to win.
----------------------------------------------------------------------------------------
*/
process {
    withName: 'CPAT_ORF' {
        ext.min_orf = 75
        ext.top_orf = 5
    }
    withName: 'FILTER_CPAT' {
        ext.cpat_coding_threshold = 0.364
    }
    withName: 'PROTEIN_CLASSIFICATION' {
        ext.min_junctions_after_stop = 0
        ext.protein_class_keep = 'FPM,NPC,NPE'
    }
}
