/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default ext.* config for the transcriptome subworkflow's modules
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Generic defaults so FILTER_TRANSCRIPTOME works standalone (no bare params.*
    reads in its main.nf). An installing pipeline's own conf/modules.config can
    override these with its own params.*-sourced values -- this file's
    includeConfig MUST come before any such override config for that to win.
----------------------------------------------------------------------------------------
*/
process {
    withName: 'FILTER_TRANSCRIPTOME' {
        ext.protein_coding_filter = true
        ext.internal_priming_filter = true
        ext.template_switching_filter = true
        ext.percent_polya_threshold = 60
        ext.transcript_class_keep = 'FSM,ISM,NIC,NNC'
    }
}
